# Firefox release configuration on Apple Silicon (non-PGO, no LTO), built only
# as far as ruyijs needs it: the export tier, then Skia, NSS/NSPR and mozglue
# (ci/firefox/deps.py). xpcshell/XUL are not built.
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/../obj/browser

export MOZILLA_OFFICIAL=1
export RUSTFLAGS=-Clto=off

ac_add_options --enable-application=browser
ac_add_options --enable-bootstrap
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --disable-tests
ac_add_options --disable-nodejs
ac_add_options --enable-rust-simd
ac_add_options --without-wasm-sandboxed-libraries
ac_add_options --enable-release
ac_add_options --enable-update-channel=release
ac_add_options --enable-official-branding
