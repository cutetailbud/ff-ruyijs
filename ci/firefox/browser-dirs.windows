security/nss/lib/freebl/freebl_hw-acc-crypto-avx
security/nss/lib/freebl/freebl_hw-acc-crypto-avx2
security/nss/lib/freebl/freebl_pqcwrap
security/nss/lib/freebl/freebl_sha-x86_c_lib
security/nss/lib/freebl/gcm_gcm-nodepend
security/nss/lib/freebl/ghash_ghash-aes-x86_c_lib
security/nss/lib/freebl/intel-gcm-wrap_intel-gcm-wrap-nodepend_c_lib
security/nss/lib/freebl/freebl_freebl3
security/nss/lib/freebl/freebl_freebl
security/nss/lib/softoken/softoken_softokn
