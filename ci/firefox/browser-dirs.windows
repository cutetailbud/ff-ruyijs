# Objdir directories built after the export tier, in link order (Windows).
# A line "DIR TARGET" builds only that make target in DIR.
# NSPR, folded into nss3 on Windows
config/external/nspr/ds
config/external/nspr/libc
config/external/nspr/pr
# mozglue.dll and what it links
mfbt
memory/build
memory/mozalloc
mozglue/misc
mozglue/baseprofiler
third_party/fmt
ipc/mscom/mozglue
toolkit/xre/dllservices/mozglue
build/pure_virtual
mozglue/build
# objects linked into nss3.dll
third_party/sqlite3/src
third_party/sqlite3/ext
security/nss/lib/base/base_nssb
security/nss/lib/certdb/certdb_certdb
security/nss/lib/certhigh/certhigh_certhi
security/nss/lib/cryptohi/cryptohi_cryptohi
security/nss/lib/dev/dev_nssdev
security/nss/lib/nss/nss_nss_static
security/nss/lib/pk11wrap/pk11wrap_pk11wrap
security/nss/lib/pkcs12/pkcs12_pkcs12
security/nss/lib/pkcs7/pkcs7_pkcs7
security/nss/lib/pki/pki_nsspki
security/nss/lib/smime/smime_smime
security/nss/lib/ssl/ssl_ssl
security/nss/lib/util/util_nssutil
# nss3.dll only: building all of security/ would recurse into security/rlbox,
# security/manager and the rest of Gecko's security code.
security ../dist/bin/nss3.dll
